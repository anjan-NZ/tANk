{
  "name": "tank",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "check:guards": "node scripts/guard-check.mjs",
    "preview": "vite preview",
    "certs": "office-addin-dev-certs install --machine",
    "start": "office-addin-debugging start manifest.xml desktop --app excel",
    "stop": "office-addin-debugging stop manifest.xml",
    "dev-server": "vite",
    "validate": "office-addin-manifest validate manifest.xml",
    "start:word": "office-addin-debugging start manifest.xml desktop --app word",
    "start:ppt": "office-addin-debugging start manifest.xml desktop --app powerpoint",
    "build:dist": "tsc -b && vite build && node scripts/make-manifest.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/office-js": "^1.0.512",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "office-addin-debugging": "^6.1.2",
    "office-addin-dev-certs": "^2.0.3",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
